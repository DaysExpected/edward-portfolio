---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'work';
}

const { title, description, page = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f3ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('has-js');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.toggle('reduced-motion', prefersReducedMotion);
      const savedLanguage = localStorage.getItem('portfolio-language');
      const initialLanguage = savedLanguage === 'zh' ? 'zh' : 'en';
      document.documentElement.dataset.lang = initialLanguage;
      document.documentElement.lang = initialLanguage === 'zh' ? 'zh-CN' : 'en';
    </script>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header page={page} />
    <main id="main-content"><slot /></main>
    <script is:inline>
      const root = document.documentElement;
      const updateLanguage = (language) => {
        root.dataset.lang = language;
        root.lang = language === 'zh' ? 'zh-CN' : 'en';
        localStorage.setItem('portfolio-language', language);
        document.querySelectorAll('[data-language-button]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.languageButton === language));
        });
      };

      document.querySelectorAll('[data-language-button]').forEach((button) => {
        button.addEventListener('click', () => updateLanguage(button.dataset.languageButton));
      });
      updateLanguage(root.dataset.lang || 'en');

      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-mobile-menu]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        menu?.toggleAttribute('data-open', !open);
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menu?.removeAttribute('data-open');
      }));

      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const heroVideo = document.querySelector('[data-hero-video]');
      const heroReplay = document.querySelector('[data-hero-replay]');
      const showFinalFrame = () => {
        if (!(heroVideo instanceof HTMLVideoElement)) return;
        heroVideo.pause();
        heroVideo.dataset.ended = 'true';
        if (heroReplay instanceof HTMLButtonElement) heroReplay.hidden = false;
      };
      const playHeroVideo = () => {
        if (!(heroVideo instanceof HTMLVideoElement)) return;
        heroVideo.muted = true;
        heroVideo.defaultMuted = true;
        heroVideo.loop = false;
        delete heroVideo.dataset.ended;
        heroVideo.play().catch(() => {
          heroVideo.dataset.autoplayBlocked = 'true';
          if (heroReplay instanceof HTMLButtonElement) heroReplay.hidden = false;
        });
      };
      const configureHeroVideo = () => {
        if (!(heroVideo instanceof HTMLVideoElement)) return;
        heroVideo.muted = true;
        heroVideo.defaultMuted = true;
        heroVideo.loop = false;
        if (heroVideo.readyState >= HTMLMediaElement.HAVE_ENOUGH_DATA) playHeroVideo();
        else heroVideo.addEventListener('canplaythrough', playHeroVideo, { once: true });
      };
      heroVideo?.addEventListener('ended', showFinalFrame);
      heroReplay?.addEventListener('click', () => {
        if (!(heroVideo instanceof HTMLVideoElement)) return;
        heroReplay.hidden = true;
        delete heroVideo.dataset.ended;
        heroVideo.currentTime = 0;
        heroVideo.play().catch(() => { heroReplay.hidden = false; });
      });
      configureHeroVideo();

      const revealSelector = [
        '.section-intro > *', '.project-featured > *', '.supporting-grid > *',
        '.project-workflow > *', '.resource-grid > *', '.about-lead > *',
        '.capability-grid article', '.about-details > *', '.contact-section > .section-index',
        '.contact-section > h2', '.contact-grid > *', '.case-hero > *', '.case-facts > *',
        '.case-nav > *', '.story-section > *', '.story-split > *', '.approach-section > *',
        '.evidence-grid > *', '.competitor-section > *', '.output-section > *'
      ].join(',');
      const revealItems = [...document.querySelectorAll(revealSelector)];
      revealItems.forEach((item) => {
        item.classList.add('reveal-item');
        const siblings = [...item.parentElement.children].filter((child) => revealItems.includes(child));
        item.style.setProperty('--reveal-order', String(Math.min(siblings.indexOf(item), 5)));
      });

      if (motionQuery.matches || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      const header = document.querySelector('.site-header');
      const homeSections = [...document.querySelectorAll('#work, #about, #contact')];
      const navLinks = [...document.querySelectorAll('.header-actions nav a[href*="#"]')];
      let scrollFrame = 0;
      const updateScrollState = () => {
        scrollFrame = 0;
        header?.classList.toggle('is-compact', window.scrollY > 72);
        let activeSection = '';
        homeSections.forEach((section) => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= window.innerHeight * 0.38 && rect.bottom > 120) activeSection = section.id;
        });
        navLinks.forEach((link) => {
          const active = link.hash === `#${activeSection}`;
          link.classList.toggle('is-current', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(updateScrollState);
      }, { passive: true });
      updateScrollState();
      requestAnimationFrame(() => document.documentElement.classList.add('motion-ready'));
    </script>
  </body>
</html>
