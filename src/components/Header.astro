---
interface Props { page?: 'home' | 'work' }
const { page = 'home' } = Astro.props;
const homePrefix = page === 'home' ? '' : '/';
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Edward Hu home">
    <strong>胡顺德个人网页</strong>
    <span>IDEAS · PROJECTS · A BRIGHTER TOMORROW</span>
  </a>
  <div class="header-controls">
    <div class="header-actions" id="primary-navigation" data-mobile-menu>
      <nav aria-label="Primary navigation">
        <a class:list={[{ active: page === 'work' }]} href={`${homePrefix}#work`}>WORK</a>
        <a href={`${homePrefix}#about`}>ABOUT</a>
        <a href="/downloads/edward-hu-resume.pdf" download="edward-hu-resume.pdf">RESUME</a>
        <a href={`${homePrefix}#contact`}>CONTACT</a>
      </nav>
    </div>
    <span class="nav-divider" aria-hidden="true"></span>
    <div class="language-switch" aria-label="Language">
      <button type="button" data-language-button="en" aria-pressed="true">EN</button><span>/</span><button type="button" data-language-button="zh" aria-pressed="false">中文</button>
    </div>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-button>
      <span data-copy-en>Menu</span><span data-copy-zh>菜单</span>
    </button>
  </div>
</header>
